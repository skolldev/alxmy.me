---
layout: layouts/base.njk
eleventyComputed:
  pageTitle: "{{ title }} | {{ site.author }}"
  ogImage: "{{ site.url }}/og/{{ page.fileSlug }}.png"
---
{%- from "icons.njk" import icon -%}
<article class="wrap">
  <header class="page-head read">
    <a class="back" href="/blog/">{{ icon("arrow-left") }} All writing</a>
    <h1 class="page-title">{{ title }}</h1>
    {% if description %}<p class="page-lede">{{ description }}</p>{% endif %}
    <p class="page-meta">
      <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      {% set rt = content | readingTime %}{% if rt %}<span class="dot" aria-hidden="true"></span><span>{{ rt }}</span>{% endif %}
    </p>
  </header>
  <div class="read prose">
    {{ content | safe }}
  </div>
</article>
