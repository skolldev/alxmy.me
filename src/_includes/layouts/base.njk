{%- from "icons.njk" import icon -%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta -->
    <title>{{ pageTitle or site.title }}</title>
    <meta
      name="description"
      content="{{ description or site.description }}"
    />
    <meta name="author" content="{{ site.author }}" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8f9fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121317" media="(prefers-color-scheme: dark)" />
    <script>
      // Resolve the theme before first paint: saved choice, else system preference.
      // Without JS, CSS falls back to prefers-color-scheme on its own.
      (() => {
        let saved = null;
        try { saved = localStorage.getItem("theme"); } catch {}
        const mq = matchMedia("(prefers-color-scheme: dark)");
        const theme = saved === "light" || saved === "dark" ? saved : mq.matches ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href="/fonts/mona-sans-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:title" content="{{ pageTitle or site.title }}" />
    <meta
      property="og:description"
      content="{{ description or site.description }}"
    />
    <meta property="og:image" content="{{ ogImage or site.url + '/images/og.png' }}" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="{{ site.author }}" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ pageTitle or site.title }}" />
    <meta
      name="twitter:description"
      content="{{ description or site.description }}"
    />
    <meta name="twitter:image" content="{{ ogImage or site.url + '/images/og.png' }}" />

    <script
      src="https://cdn.usefathom.com/script.js"
      data-site="{{ site.fathomSiteId }}"
      defer
    ></script>
    <link rel="stylesheet" href="/css/output.css" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header" data-header>
      <div class="wrap">
        <a class="wordmark" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Alexander May</a>
        <nav class="nav" aria-label="Main">
          <a href="/#work">Work</a>
          <a href="/blog/"{% if page.url.startsWith("/blog") %} aria-current="page"{% endif %}>Writing</a>
          <a href="/#contact">Contact</a>
          <button class="theme-toggle" type="button" data-theme-toggle hidden aria-label="Switch to dark theme">
            {{ icon("moon", "icon-moon") }}{{ icon("sun", "icon-sun") }}
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <small>&copy; {% year %} {{ site.author }} · Munich</small>
        <nav aria-label="Legal">
          <a href="/imprint">Imprint</a>
          <a href="/privacy">Privacy</a>
        </nav>
      </div>
    </footer>

    <script>
      (() => {
        const header = document.querySelector("[data-header]");
        if (!header) return;
        const onScroll = () => header.toggleAttribute("data-scrolled", window.scrollY > 8);
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      })();

      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector("[data-theme-toggle]");
        const metas = document.querySelectorAll('meta[name="theme-color"]');
        const colors = { light: "#f8f9fb", dark: "#121317" };
        const mq = matchMedia("(prefers-color-scheme: dark)");
        const saved = () => {
          try { return localStorage.getItem("theme"); } catch { return null; }
        };

        const apply = (theme) => {
          root.dataset.theme = theme;
          metas.forEach((m) => (m.content = colors[theme]));
          if (toggle) {
            const next = theme === "dark" ? "light" : "dark";
            toggle.setAttribute("aria-label", `Switch to ${next} theme`);
            toggle.title = `Switch to ${next} theme`;
          }
        };

        apply(root.dataset.theme === "dark" ? "dark" : "light");

        // Follow the system until the visitor makes an explicit choice.
        mq.addEventListener("change", (e) => {
          if (!saved()) apply(e.matches ? "dark" : "light");
        });

        if (!toggle) return;
        toggle.hidden = false;
        toggle.addEventListener("click", () => {
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          apply(next);
          // Picking the system's own theme clears the override, so it keeps following the OS.
          try {
            if (next === (mq.matches ? "dark" : "light")) localStorage.removeItem("theme");
            else localStorage.setItem("theme", next);
          } catch {}
        });
      })();
    </script>
  </body>
</html>
