<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta -->
    <title>{{ pageTitle or site.title }}</title>
    <meta
      name="description"
      content="{{ description or site.description }}"
    />
    <meta name="author" content="{{ site.author }}" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:title" content="{{ pageTitle or site.title }}" />
    <meta
      property="og:description"
      content="{{ description or site.description }}"
    />
    <meta property="og:image" content="{{ site.url }}/images/og.png" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="{{ site.author }}" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ pageTitle or site.title }}" />
    <meta
      name="twitter:description"
      content="{{ description or site.description }}"
    />
    <meta name="twitter:image" content="{{ site.url }}/images/og.png" />

    <script
      src="https://cdn.usefathom.com/script.js"
      data-site="{{ site.fathomSiteId }}"
      defer
    ></script>
    <link rel="stylesheet" href="/css/output.css" />
  </head>
  <body class="bg-brand-black text-white font-mono leading-relaxed">
    <div
      class="grid-base fixed inset-0 pointer-events-none"
      aria-hidden="true"
    ></div>
    <div
      class="grid-glow fixed inset-0 pointer-events-none motion-reduce:hidden"
      aria-hidden="true"
    ></div>
    <div
      class="noise fixed inset-0 pointer-events-none opacity-[0.03]"
      aria-hidden="true"
    ></div>

    <div class="max-w-[1400px] mx-auto p-4 sm:p-8">
      {{ content | safe }}

      <footer
        class="mt-8 p-6 sm:p-8 border-[3px] border-white flex justify-between items-center text-xs tracking-widest not-motion-reduce:animate-slide-up"
        style="animation-delay: 0.6s"
      >
        <small class="uppercase">&copy; {{ 2026 }} {{ site.author }}</small>
        <nav class="flex gap-6 uppercase">
          <a href="/imprint" class="hover:text-brand-yellow transition-colors">Imprint</a>
          <a href="/privacy" class="hover:text-brand-yellow transition-colors">Privacy</a>
        </nav>
      </footer>
    </div>

    <script>
      const gridBase = document.querySelector(".grid-base");
      const gridGlow = document.querySelector(".grid-glow");

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (gridBase && gridGlow && !prefersReducedMotion) {
        let frameId = 0;
        document.addEventListener("mousemove", (e) => {
          cancelAnimationFrame(frameId);
          frameId = requestAnimationFrame(() => {
            const x = (e.clientX / window.innerWidth - 0.5) * 10;
            const y = (e.clientY / window.innerHeight - 0.5) * 10;
            const pos = `${x}px ${y}px`;
            gridBase.style.backgroundPosition = pos;
            gridGlow.style.backgroundPosition = pos;

            gridGlow.style.setProperty("--mx", e.clientX + "px");
            gridGlow.style.setProperty("--my", e.clientY + "px");
          });
        });
      }
    </script>
  </body>
</html>
