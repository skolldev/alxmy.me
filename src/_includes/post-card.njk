<li class="post-row">
  {% set hTag = postHeading or "h3" %}<{{ hTag }} class="post-title"><a href="{{ post.url }}">{{ post.data.title }}</a></{{ hTag }}>
  {% if post.data.description %}<p class="post-desc">{{ post.data.description }}</p>{% endif %}
  <p class="post-meta">
    <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>{% set rt = post.content | readingTime %}{% if rt %}<br />{{ rt }}{% endif %}
  </p>
</li>
