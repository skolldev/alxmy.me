---
layout: layouts/base.njk
pageTitle: "Alexander May | Frontend Engineer"
description: "Alexander May, frontend engineer in Munich. Ten years building production applications in Angular and TypeScript, currently at codecentric."
---
{%- from "icons.njk" import icon -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "{{ site.author }}",
  "url": "{{ site.url }}",
  "jobTitle": "Frontend Engineer",
  "description": "Frontend engineer specialising in Angular and TypeScript",
  "knowsAbout": ["Angular", "TypeScript", "Tailwind CSS", "Testing Library"],
  "worksFor": {
    "@type": "Organization",
    "name": "codecentric",
    "url": "https://codecentric.de"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Munich",
    "addressCountry": "DE"
  },
  "sameAs": [{% for link in site.social %}
    "{{ link.url }}"{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
</script>

<section class="hero" aria-labelledby="hero-heading">
  <div class="wrap hero-grid">
    <div>
      <h1 id="hero-heading">Alexander<br />May</h1>
      <p class="hero-role">
        Frontend engineer in Munich. Ten years of Angular and TypeScript, currently at codecentric.
      </p>
      <p class="hero-stance">
        Clients bring hard problems. I leave behind systems that last and teams
        that feel confident changing them.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="mailto:{{ site.email }}">
          Get in touch {{ icon("arrow-right") }}
        </a>
        {% for link in site.social %}
        <a class="btn btn-ghost" href="{{ link.url }}"{% if link.external %} target="_blank" rel="noopener"{% endif %}>
          {{ link.label }}{% if link.external %}<span class="sr-only"> (opens in new tab)</span>{% endif %}
          {{ icon("arrow-up-right", "ext") }}
        </a>
        {% endfor %}
      </div>
    </div>

    <div class="stage" id="work">
      <section class="panel" aria-labelledby="work-heading" data-panel>
        <header class="panel-head">
          <h2 class="panel-title" id="work-heading">
            Recent projects <span class="count">{{ projects | length }}</span>
          </h2>
          <span class="panel-meta">Client work &amp; open source</span>
        </header>
        <ul class="projects" role="list">
          {% for project in projects %}
          <li class="project{% if project.url %} is-link{% endif %}">
            <h3 class="project-name">
              {%- if project.url -%}
              <a href="{{ project.url }}" target="_blank" rel="noopener">{{ project.name }}<span class="sr-only"> (opens in new tab)</span></a>{{ icon("arrow-up-right", "ext") }}
              {%- else -%}{{ project.name }}{%- endif -%}
            </h3>
            <span class="tag">{{ project.industry }}</span>
            {% if project.description %}
            <p class="project-desc">{{ project.description }}</p>
            {% elif project.nda %}
            <p class="project-desc is-nda">Details under NDA</p>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
        <div class="panel-foot">
          {% set latest = collections.posts | first %}
          {% if latest %}
          <div class="foot-cell">
            <p class="foot-label">Latest writing</p>
            <a class="latest" href="{{ latest.url }}">
              <span>{{ latest.data.title }}</span>{{ icon("arrow-right") }}
            </a>
          </div>
          {% endif %}
          <div class="foot-cell">
            <p class="foot-label">Current stack</p>
            <ul class="chips" role="list">
              <li>Angular</li>
              <li>TypeScript</li>
              <li>Tailwind</li>
              <li>Testing Library</li>
            </ul>
          </div>
        </div>
      </section>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="profile-heading">
  <div class="wrap section-grid">
    <div class="section-head">
      <h2 id="profile-heading">How I work</h2>
      <p class="section-lede">
        Specialised in Angular and TypeScript. Pragmatic beyond that.
      </p>
    </div>
    <div>
      <div class="prose-lg">
        <p>
          <s>I build enterprise-grade systems that don't break.</s><span class="sr-only"> (scratch that)</span>
          I build calm, durable software and push back when complexity doesn't earn its keep.
        </p>
        <p>
          Ten years building production systems across Automotive, EdTech, FinTech,
          Logistics and Insurance. Currently at
          <a href="https://codecentric.de" target="_blank" rel="noopener">codecentric<span class="sr-only"> (opens in new tab)</span></a>.
        </p>
      </div>
      <p class="aside-note">
        When not coding: lifting heavy things, obsessing over Neapolitan pizza,
        building (and breaking) my homelab, and D&amp;D campaigns.
      </p>
    </div>
  </div>
  <div class="wrap">
    <ul class="principles" role="list">
      <li>
        <strong>Design together</strong>
        <span>I favour early, direct collaboration with UX over ticket-driven handoffs.</span>
      </li>
      <li>
        <strong>Boring on purpose</strong>
        <span>I prefer boring, readable systems over clever ones.</span>
      </li>
      <li>
        <strong>No, with reasons</strong>
        <span>I say no when I need to, and I explain why.</span>
      </li>
    </ul>
  </div>
</section>

<section class="section" aria-labelledby="writing-heading">
  <div class="wrap section-grid">
    <div class="section-head">
      <h2 id="writing-heading">Writing</h2>
      <p class="section-lede">Opinions on Angular, code review, and the habits of our industry.</p>
    </div>
    <div>
      {% if collections.posts.length %}
      <ul class="post-list" role="list">
        {% for post in collections.posts %}{% if loop.index0 < 3 %}
          {% include "post-card.njk" %}
        {% endif %}{% endfor %}
      </ul>
      <a class="more" href="/blog/">All writing {{ icon("arrow-right") }}</a>
      {% else %}
      <p class="post-desc">No posts yet. Check back soon.</p>
      {% endif %}
    </div>
  </div>
</section>

<section class="close" id="contact" aria-labelledby="contact-heading">
  <div class="wrap">
    <h2 id="contact-heading">Bring me a hard problem.</h2>
    <p>
      The fastest way to reach me is email:
      <a class="email" href="mailto:{{ site.email }}">{{ site.email }}</a>
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="mailto:{{ site.email }}">
        {{ icon("mail") }} Write an email
      </a>
      {% for link in site.social %}
      <a class="btn btn-ghost" href="{{ link.url }}"{% if link.external %} target="_blank" rel="noopener"{% endif %}>
        {{ link.label }}{% if link.external %}<span class="sr-only"> (opens in new tab)</span>{% endif %}
        {{ icon("arrow-up-right", "ext") }}
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (() => {
    const panel = document.querySelector("[data-panel]");
    if (!panel || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let frame = 0;
    panel.addEventListener("pointermove", (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = panel.getBoundingClientRect();
        panel.style.setProperty("--mx", `${e.clientX - r.left}px`);
        panel.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });
  })();
</script>
