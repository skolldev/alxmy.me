    aria-labelledby="blog-heading"
  >
    <h2 id="blog-heading" class="section-label">
      <span aria-hidden="true">006 // </span>Blog
    </h2>
    {% for post in collections.posts | reverse %}
      {% if loop.index0 < 3 %}
        <a href="{{ post.url }}" class="link-item group">
          <div>
            <span class="font-bold text-lg uppercase">{{ post.data.title }}</span>
            <div class="mt-1">
              <time class="text-xs tracking-[0.2em] opacity-70 uppercase" datetime="{{ post.date | isoDate }}">
              {{ post.date | readableDate }}
              </time>
              {% set rt = post.content | readingTime %}
              {% if rt %}
                <span class="text-xs tracking-[0.2em] opacity-70 uppercase">&#8226 {{ rt }}</span>
              {% endif %}
            </div>
          </div>
          <span
            class="transition-transform group-hover:translate-x-[5px]"
            aria-hidden="true"
          >&rarr;</span>
        </a>
      {% endif %}
    {% else %}
      <p class="text-lg opacity-70">No posts yet. Check back soon.</p>
    {% endfor %}
    <a href="/blog" class="link-item group">
      <span class="font-bold text-lg uppercase">All Posts</span>
      <span
        class="transition-transform group-hover:translate-x-[5px]"
        aria-hidden="true"
      >&rarr;</span>
    </a>
