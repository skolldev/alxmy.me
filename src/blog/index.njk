---
layout: layouts/base.njk
pageTitle: "Blog | Alexander May"
description: "Thoughts on frontend engineering, security, and building software that lasts."
---
<header class="section-box p-6 sm:p-12 mb-8 animate-slide-down">
  <span class="section-label" aria-hidden="true">blog</span>
  <h1 class="text-[2rem] sm:text-[clamp(2.5rem,8vw,5rem)] font-extrabold leading-[0.9] -tracking-[0.03em] uppercase">
    Blog
  </h1>
</header>

<main class="section-box not-motion-reduce:animate-slide-up" style="animation-delay: 0.1s">
  {% for post in collections.posts %}
    <a href="{{ post.url }}" class="link-item group">
      <div>
        <span class="font-bold text-lg uppercase">{{ post.data.title }}</span>
        <div class="mt-1">
          <time class="text-xs tracking-[0.2em] opacity-70 uppercase" datetime="{{ post.date | isoDate }}">
          {{ post.date | readableDate }}
          </time>
          {% set rt = post.content | readingTime %}
          {% if rt %}
            <span class="text-xs tracking-[0.2em] opacity-70 uppercase">&#8226 {{ rt }}</span>
          {% endif %}
        </div>
      </div>
      <span
        class="transition-transform group-hover:translate-x-[5px]"
        aria-hidden="true"
      >&rarr;</span>
    </a>
  {% else %}
    <p class="text-lg opacity-70">No posts yet. Check back soon.</p>
  {% endfor %}
</main>
<nav class="mt-8 not-motion-reduce:animate-slide-up" style="animation-delay: 0.2s">
  <a href="/" class="link-item group inline-flex gap-2 border-0 hover:text-brand-yellow transition-colors">
    <span class="transition-transform group-hover:-translate-x-[5px]" aria-hidden="true">&larr;</span>
    <span class="font-bold text-lg uppercase">Back to Home</span>
  </a>
</nav>
