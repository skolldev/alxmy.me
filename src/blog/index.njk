---
layout: layouts/base.njk
pageTitle: "Writing | Alexander May"
description: "Thoughts on frontend engineering, code review, and building software that lasts."
---
<div class="wrap">
  <header class="page-head read">
    <h1 class="page-title">Writing</h1>
    <p class="page-lede">Thoughts on frontend engineering, code review, and building software that lasts.</p>
  </header>
  <div class="read prose-pad">
    {% if collections.posts.length %}
    {% set postHeading = "h2" %}
    <ul class="post-list" role="list">
      {% for post in collections.posts %}
        {% include "post-card.njk" %}
      {% endfor %}
    </ul>
    {% else %}
    <p class="post-desc">No posts yet. Check back soon.</p>
    {% endif %}
  </div>
</div>
