{
  "name": "alxmy.me",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:11ty": "npx @11ty/eleventy --serve",
    "dev:css": "npx @tailwindcss/cli -i src/css/input.css -o _site/css/output.css --watch",
    "build": "npm-run-all build:css build:11ty build:og",
    "build:css": "npx @tailwindcss/cli -i src/css/input.css -o _site/css/output.css --minify",
    "build:11ty": "npx @11ty/eleventy",
    "build:og": "node generate-og.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/cli": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "reading-time": "^1.5.0",
    "satori": "^0.19.1",
    "tailwindcss": "^4.0.0",
    "wawoff2": "^2.0.1"
  }
}
